<!DOCTYPE benchmark PUBLIC "+//IDN sosy-lab.org//DTD BenchExec benchmark 2.3//EN" "https://www.sosy-lab.org/benchexec/benchmark-2.3.dtd">
<benchmark tool="cpachecker" timelimit="30s" hardtimelimit="40s" memlimit="400MB" cpuCores="1">
    <option name="--heap">300M</option>
    <option name="--no-output-files"/>
    <option name="--option">cpa.smg.runtimeCheck=FULL</option>

    <rundefinition name="smg">
        <option name="--smg-ldv"/>
        <option name="--option">cpa.smg.enableHeapAbstraction=false</option>
        <option name="--option">cpa.smg.trackPredicates=false</option>
        <option name="--option">cpa.smg.trackErrorPredicates=false</option>
        <option name="--option">cpa.smg.verifyPredicates=false</option>
    </rundefinition>
    <rundefinition name="smg-ldv">
        <option name="--smg-ldv"/>
    </rundefinition>

    <!-- From integration-smg.xml -->
    <!-- 24 files -->
    <tasks name="cpalien">
        <includesfile>../../programs/cpalien/cpalien.set</includesfile>
        <requiredfiles>../../programs/cpalien/cpalien-headers.h</requiredfiles>
        <option name="--preprocess" />
        <propertyfile>../../config/properties/valid-memsafety.prp</propertyfile>
    </tasks>

    <!-- 39 files -->
    <tasks name="ext-alloc">
        <includesfile>../../programs/smg_External_Allocation_Test/ExtAlloc.set</includesfile>
        <propertyfile>../../config/properties/valid-memsafety.prp</propertyfile>
    </tasks>

    <!-- From integration-nightly-smg.xml -->
    <!-- 56 files -->
    <tasks name="other">
        <includesfile>../../programs/benchmarks/MemSafety-Other.set</includesfile>
        <propertyfile>../../programs/benchmarks/properties/valid-memsafety.prp</propertyfile>
    </tasks>

    <!-- 72 files. note that falses miss subproperties -->
    <tasks name="across-juliet">
        <includesfile>juliet-every-251th.set</includesfile>
        <propertyfile>../../programs/benchmarks/properties/valid-memsafety.prp</propertyfile>
    </tasks>

    <!-- 24+41=65 files -->
    <tasks name="memcleanup">
        <includesfile>other-memcleanup.set</includesfile>
        <includesfile>juliet-memcleanup.set</includesfile>
        <propertyfile>../../programs/benchmarks/properties/valid-memcleanup.prp</propertyfile>
    </tasks>

    <columns>
        <column title="reached">Size of reached set</column>
        <column title="transfer">Time for transfer relation</column>
        <column title="stop">Time for stop operator</column>
        <column title="error">Error</column>
        <column title="exception">Exception</column>
    </columns>
</benchmark>
