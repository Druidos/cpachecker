<!DOCTYPE benchmark PUBLIC "+//IDN sosy-lab.org//DTD BenchExec benchmark 1.0//EN" "http://www.sosy-lab.org/benchexec/benchmark-1.0.dtd">
<benchmark tool="cpachecker" timelimit="60 s" hardtimelimit="90 s" memlimit="1 GB" cpuCores="1">
    <option name="-noout"/>
    <option name="-heap">512M</option>

    <rundefinition name="smg-ldv-2-runtimeCheck=FULL">
        <option name="-setprop">cpa.smg.seqLengthEqualityThreshold=2</option>
        <option name="-setprop">cpa.smg.seqLengthEntailmentThreshold=2</option>
        <option name="-setprop">cpa.smg.seqLengthIncomparableThreshold=2</option>
        <option name="-setprop">cpa.smg.runtimeCheck=FULL</option>
    </rundefinition>
    <rundefinition name="smg-ldv-223-runtimeCheck=FULL">
        <option name="-setprop">cpa.smg.seqLengthEqualityThreshold=2</option>
        <option name="-setprop">cpa.smg.seqLengthEntailmentThreshold=2</option>
        <option name="-setprop">cpa.smg.seqLengthIncomparableThreshold=3</option>
        <option name="-setprop">cpa.smg.runtimeCheck=FULL</option>
    </rundefinition>
    <rundefinition name="smg-ldv-3-runtimeCheck=FULL">
        <option name="-setprop">cpa.smg.seqLengthEqualityThreshold=3</option>
        <option name="-setprop">cpa.smg.seqLengthEntailmentThreshold=3</option>
        <option name="-setprop">cpa.smg.seqLengthIncomparableThreshold=3</option>
        <option name="-setprop">cpa.smg.runtimeCheck=FULL</option>
    </rundefinition>
    <rundefinition name="smg-ldv-15-runtimeCheck=FULL">
        <option name="-setprop">cpa.smg.seqLengthEqualityThreshold=15</option>
        <option name="-setprop">cpa.smg.seqLengthEntailmentThreshold=15</option>
        <option name="-setprop">cpa.smg.seqLengthIncomparableThreshold=15</option>
        <option name="-setprop">cpa.smg.runtimeCheck=FULL</option>
    </rundefinition>
    <option name="-smg-ldv"/>
    <option name="-preprocess" />
    <option name="-noout"></option>
    <option name="-stats"></option>
    <propertyfile>../../config/properties/valid-memsafety.prp</propertyfile>
    <tasks name="smg_abstraction">
        <includesfile>../../programs/smg_abstraction_tests/smg_abstraction.set</includesfile>
    </tasks>

</benchmark>
