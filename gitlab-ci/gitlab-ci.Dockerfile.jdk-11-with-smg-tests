# This is a Docker image for running the tests, including integration tests for SMG.
#
# Currently, commands for updating the image are:
# python3 copy-tests-from-benchmarks.py  # copies only necessary files into gitlab-ci/test
# docker build --pull -t gitlab.ispras.ru:4567/verification/cpachecker/test:jdk-11 -f gitlab-ci/gitlab-ci.Dockerfile.jdk-11-with-smg-tests ./gitlab-ci/
# docker push gitlab.ispras.ru:4567/verification/cpachecker/test:jdk-11

FROM registry.gitlab.com/sosy-lab/software/java-project-template/test:jdk-11
RUN apt-get update && apt-get install -y \
  gcc \
  graphviz \
  libgmp10 \
  libgomp1 \
  python3 \
  clang-9

COPY test/ /test/
